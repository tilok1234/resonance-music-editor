{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.local/schema/render-report-v1.json",
  "title": "Resonance Offline Render Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "editorVersion",
    "projectPath",
    "wavPath",
    "title",
    "sampleRate",
    "bitsPerSample",
    "trackCount",
    "repeats",
    "tailSeconds",
    "renderedSamples",
    "renderedSeconds",
    "fileBytes",
    "peak",
    "peakDbfs",
    "rmsDbfs",
    "clippedSamples",
    "invalidSampleCount",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "editorVersion": { "type": "string", "minLength": 1 },
    "projectPath": { "type": "string" },
    "wavPath": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "sampleRate": { "type": "integer", "enum": [44100, 48000, 88200, 96000] },
    "bitsPerSample": { "const": 24 },
    "trackCount": { "type": "integer", "minimum": 1, "maximum": 4 },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 64 },
    "tailSeconds": { "type": "number", "minimum": 0, "maximum": 30 },
    "renderedSamples": { "type": "integer", "minimum": 1 },
    "renderedSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "fileBytes": { "type": "integer", "minimum": 1 },
    "peak": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "peakDbfs": { "type": "number", "maximum": 0 },
    "rmsDbfs": { "type": "number", "maximum": 0 },
    "clippedSamples": { "const": 0 },
    "invalidSampleCount": { "const": 0 },
    "passed": { "const": true },
    "error": { "type": "string" }
  }
}
