{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.local/schema/song-project-test-v1.json",
  "title": "Resonance song project test report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "testVersion",
    "juceVersion",
    "editCommandVersion",
    "editCommandFixture",
    "projectSchemaVersion",
    "legacySchemaVersion",
    "legacyMigrationFixture",
    "legacyMigrationPassed",
    "legacySourceSha256",
    "migratedRoundTripBytes",
    "stableTrackId",
    "stableClipId",
    "editCommandCandidateSha256",
    "seededVelocitySeed",
    "seededVelocityMaximumDelta",
    "seededVelocityCommandSha256",
    "seededVelocityCandidateSha256",
    "assertions",
    "roundTripBytes",
    "stateSha256",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "testVersion": { "type": "string", "minLength": 1 },
    "juceVersion": { "type": "string", "minLength": 1 },
    "editCommandVersion": { "const": 1 },
    "editCommandFixture": { "const": "edit-command-note-patch-v1.json" },
    "projectSchemaVersion": { "const": 2 },
    "legacySchemaVersion": { "const": 1 },
    "legacyMigrationFixture": { "const": "song-project-v1-migration.resonance.json" },
    "legacyMigrationPassed": { "const": true },
    "legacySourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "migratedRoundTripBytes": { "type": "integer", "minimum": 500 },
    "stableTrackId": { "const": "track-migrated" },
    "stableClipId": { "const": "clip-migrated" },
    "editCommandCandidateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "seededVelocitySeed": { "const": 18421 },
    "seededVelocityMaximumDelta": { "const": 8 },
    "seededVelocityCommandSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "seededVelocityCandidateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "assertions": { "type": "integer", "minimum": 50 },
    "roundTripBytes": { "type": "integer", "minimum": 500 },
    "stateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "passed": { "const": true }
  }
}
