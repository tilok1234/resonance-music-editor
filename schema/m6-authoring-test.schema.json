{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.local/schema/m6-authoring-test-v1.json",
  "title": "Resonance M6 two-track authoring test report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "editorVersion",
    "projectPath",
    "audioEmitted",
    "initialTrackCount",
    "preloadedPluginCount",
    "distinctRuntimeInstances",
    "addTrackSucceeded",
    "activeTrackAfterAdd",
    "firstTrackId",
    "secondTrackId",
    "stableDistinctIds",
    "duplicatedStateExact",
    "runtimeStateAlignedAfterAdd",
    "independentNotes",
    "independentMixerSettings",
    "reorderSucceeded",
    "runtimeStateAlignedAfterReorder",
    "undoReorderRestored",
    "saveSucceeded",
    "reopenedSchemaVersion",
    "reopenedTrackCount",
    "reopenedOrderPreserved",
    "reopenedMixerPreserved",
    "reopenedIndependentNotes",
    "removeSucceeded",
    "undoRemoveRestored",
    "invalidSampleCount",
    "processorExceptionCount",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "editorVersion": { "const": "0.5.0" },
    "projectPath": { "const": "m6-two-track-authoring.resonance.json" },
    "audioEmitted": { "const": false },
    "initialTrackCount": { "const": 1 },
    "preloadedPluginCount": { "const": 4 },
    "distinctRuntimeInstances": { "const": true },
    "addTrackSucceeded": { "const": true },
    "activeTrackAfterAdd": { "const": 1 },
    "firstTrackId": { "type": "string", "minLength": 1 },
    "secondTrackId": { "type": "string", "minLength": 1 },
    "stableDistinctIds": { "const": true },
    "duplicatedStateExact": { "const": true },
    "runtimeStateAlignedAfterAdd": { "const": true },
    "independentNotes": { "const": true },
    "independentMixerSettings": { "const": true },
    "reorderSucceeded": { "const": true },
    "runtimeStateAlignedAfterReorder": { "const": true },
    "undoReorderRestored": { "const": true },
    "saveSucceeded": { "const": true },
    "reopenedSchemaVersion": { "const": 5 },
    "reopenedTrackCount": { "const": 2 },
    "reopenedOrderPreserved": { "const": true },
    "reopenedMixerPreserved": { "const": true },
    "reopenedIndependentNotes": { "const": true },
    "removeSucceeded": { "const": true },
    "undoRemoveRestored": { "const": true },
    "invalidSampleCount": { "const": 0 },
    "processorExceptionCount": { "const": 0 },
    "passed": { "const": true },
    "error": { "type": "string", "minLength": 1 }
  }
}
