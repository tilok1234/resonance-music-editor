{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.local/schema/song-project-v2.json",
  "title": "Resonance Song Project v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "editorVersion",
    "title",
    "sampleRate",
    "ppq",
    "tempoMap",
    "meterMap",
    "editor",
    "tracks"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "editorVersion": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "sampleRate": { "type": "integer", "enum": [44100, 48000, 88200, 96000] },
    "ppq": { "type": "integer", "const": 960 },
    "tempoMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "bpm"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0 },
          "bpm": { "type": "number", "minimum": 40, "maximum": 240 }
        }
      }
    },
    "meterMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "numerator", "denominator"],
        "properties": {
          "tick": { "type": "integer", "minimum": 0 },
          "numerator": { "type": "integer", "minimum": 1 },
          "denominator": { "type": "integer", "enum": [1, 2, 4, 8, 16, 32] }
        }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapBeats"],
      "properties": {
        "snapBeats": { "type": "number", "enum": [0.125, 0.25, 0.5, 1.0] }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "mixer", "midi", "instrument", "clips"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "const": "instrument" },
          "mixer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gainDb", "pan", "mute", "solo"],
            "properties": {
              "gainDb": { "type": "number", "minimum": -60, "maximum": 12 },
              "pan": { "type": "number", "minimum": -1, "maximum": 1 },
              "mute": { "type": "boolean" },
              "solo": { "type": "boolean" }
            }
          },
          "midi": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputChannel", "outputChannel"],
            "properties": {
              "inputChannel": { "type": "integer", "minimum": 0, "maximum": 16 },
              "outputChannel": { "type": "integer", "minimum": 1, "maximum": 16 }
            }
          },
          "instrument": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "pluginIdentifier",
              "pluginName",
              "vendor",
              "version",
              "stateEncoding",
              "state",
              "stateSha256"
            ],
            "properties": {
              "format": { "const": "VST3" },
              "pluginIdentifier": { "type": "string", "minLength": 1 },
              "pluginName": { "type": "string", "minLength": 1 },
              "vendor": { "type": "string" },
              "version": { "type": "string" },
              "soundName": { "type": "string", "minLength": 1, "maxLength": 80 },
              "stateEncoding": { "const": "base64" },
              "state": { "type": "string", "minLength": 1 },
              "stateSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
            }
          },
          "clips": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "startTick", "lengthTicks", "loopEnabled", "notes"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "startTick": { "type": "integer", "const": 0 },
                "lengthTicks": { "type": "integer", "minimum": 3840, "maximum": 30720 },
                "loopEnabled": { "const": true },
                "notes": {
                  "type": "array",
                  "maxItems": 512,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "startTick", "lengthTicks", "midiNote", "velocity"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "startTick": { "type": "integer", "minimum": 0 },
                      "lengthTicks": { "type": "integer", "minimum": 1 },
                      "midiNote": { "type": "integer", "minimum": 0, "maximum": 127 },
                      "velocity": { "type": "integer", "minimum": 1, "maximum": 127 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
