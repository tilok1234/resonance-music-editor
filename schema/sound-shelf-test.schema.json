{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.local/schema/sound-shelf-test-v1.json",
  "title": "Resonance Sound Shelf Test Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "testVersion",
    "shelfSchemaVersion",
    "acceptedSoundSha256",
    "shelfSoundSha256",
    "soundsDiffer",
    "savedAcceptedToShelf",
    "addedSecondSound",
    "shelfSurvivesReload",
    "loadedAsCandidate",
    "acceptedUnchangedByLoad",
    "rejectRestoredAccepted",
    "appliedShelfSound",
    "undoRestoredAccepted",
    "foreignInstrumentRefused",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "testVersion": { "type": "string", "minLength": 1 },
    "shelfSchemaVersion": { "const": 1 },
    "acceptedSoundSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "shelfSoundSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "soundsDiffer": { "const": true },
    "savedAcceptedToShelf": { "const": true },
    "addedSecondSound": { "const": true },
    "shelfSurvivesReload": { "const": true },
    "loadedAsCandidate": { "const": true },
    "acceptedUnchangedByLoad": { "const": true },
    "rejectRestoredAccepted": { "const": true },
    "appliedShelfSound": { "const": true },
    "undoRestoredAccepted": { "const": true },
    "foreignInstrumentRefused": { "const": true },
    "passed": { "const": true },
    "error": { "type": "string" }
  }
}
