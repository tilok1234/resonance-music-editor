{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.local/schema/audio-probe-v1.json",
  "title": "Resonance Per-Track Audio Probe Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "testVersion",
    "projectPath",
    "trackCount",
    "blockCount",
    "tracks",
    "audibleTrackCount",
    "expectedAudibleTrackCount",
    "masterPeak",
    "clipped",
    "invalidSampleCount",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "testVersion": { "type": "string", "minLength": 1 },
    "projectPath": { "type": "string", "minLength": 1 },
    "trackCount": { "type": "integer", "minimum": 1, "maximum": 4 },
    "blockCount": { "type": "integer", "minimum": 64 },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "name",
          "noteCount",
          "midiOutputChannel",
          "gainDb",
          "peak",
          "processedBlocks",
          "muted",
          "shouldSound",
          "audible"
        ],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 3 },
          "name": { "type": "string", "minLength": 1 },
          "noteCount": { "type": "integer", "minimum": 0, "maximum": 512 },
          "midiOutputChannel": { "type": "integer", "minimum": 1, "maximum": 16 },
          "gainDb": { "type": "number", "minimum": -60, "maximum": 12 },
          "peak": { "type": "number", "minimum": 0 },
          "processedBlocks": { "type": "integer", "minimum": 1 },
          "muted": { "type": "boolean" },
          "shouldSound": { "type": "boolean" },
          "audible": { "type": "boolean" }
        }
      }
    },
    "audibleTrackCount": { "type": "integer", "minimum": 0, "maximum": 4 },
    "expectedAudibleTrackCount": { "type": "integer", "minimum": 1, "maximum": 4 },
    "masterPeak": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "clipped": { "const": false },
    "invalidSampleCount": { "const": 0 },
    "passed": { "const": true },
    "error": { "type": "string" }
  }
}
