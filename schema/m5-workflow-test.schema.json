{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.local/schema/m5-workflow-test-v1.json",
  "title": "Resonance M5 proposal workflow test report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "selectedNoteId",
    "originalPitch",
    "candidatePitch",
    "beforeContentSha256",
    "candidateContentSha256",
    "previewCreated",
    "firstPreviewStatus",
    "activeUnchangedDuringPreview",
    "projectCleanDuringPreview",
    "diffCount",
    "updateDiff",
    "soundLaneInterlocked",
    "savePreservedAcceptedA",
    "candidateAuditionSelected",
    "activeUnchangedAfterCandidateAudition",
    "projectAuditionSelected",
    "rejectedWithoutMutation",
    "applyPreviewCreated",
    "applied",
    "applyProducedOneUndo",
    "undoRestoredBefore",
    "redoRestoredCandidate",
    "stalePreviewInvalidated",
    "finalRestored",
    "closeAcceptedWithoutWarning",
    "invalidSampleCount",
    "processorExceptionCount",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "selectedNoteId": { "type": "string", "minLength": 1 },
    "originalPitch": { "type": "integer", "minimum": 0, "maximum": 126 },
    "candidatePitch": { "type": "integer", "minimum": 1, "maximum": 127 },
    "beforeContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidateContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "previewCreated": { "const": true },
    "firstPreviewStatus": { "const": "NOTE B READY  /  AUDITION A-B BEFORE APPLY" },
    "activeUnchangedDuringPreview": { "const": true },
    "projectCleanDuringPreview": { "const": true },
    "diffCount": { "const": 1 },
    "updateDiff": { "const": true },
    "soundLaneInterlocked": { "const": true },
    "savePreservedAcceptedA": { "const": true },
    "candidateAuditionSelected": { "const": true },
    "activeUnchangedAfterCandidateAudition": { "const": true },
    "projectAuditionSelected": { "const": true },
    "rejectedWithoutMutation": { "const": true },
    "applyPreviewCreated": { "const": true },
    "applied": { "const": true },
    "applyProducedOneUndo": { "const": true },
    "undoRestoredBefore": { "const": true },
    "redoRestoredCandidate": { "const": true },
    "stalePreviewInvalidated": { "const": true },
    "finalRestored": { "const": true },
    "closeAcceptedWithoutWarning": { "const": true },
    "invalidSampleCount": { "const": 0 },
    "processorExceptionCount": { "const": 0 },
    "passed": { "const": true },
    "error": { "type": "string", "minLength": 1 }
  }
}
